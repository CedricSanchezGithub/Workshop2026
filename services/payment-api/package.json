{
  "name": "pay-and-go",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config front/vite.config.js",
    "build": "vite --config front/vite.config.js build",
    "preview": "vite --config front/vite.config.js preview",
    "api:dev": "tsx watch backend/api/src/main.ts",
    "api:start": "tsx backend/api/src/main.ts",
    "worker:start": "tsx backend/services/payment-worker/src/main.ts",
    "db:init": "powershell -ExecutionPolicy Bypass -File ./infra/scripts/db-init.ps1",
    "api:check": "tsc -p backend/tsconfig.json --noEmit",
    "test:api": "node --import tsx --test front/tests/api-smoke.test.ts",
    "test": "node --import tsx --test front/tests/auth.test.ts front/tests/auth-lockout.test.ts front/tests/face-challenge.test.ts front/tests/payment.test.ts front/tests/chat.test.ts front/tests/metrics.test.ts front/tests/structure.test.ts"
  },
  "dependencies": {
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "latest",
    "clsx": "latest",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jdenticon": "^3.3.0",
    "lucide-react": "latest",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "latest",
    "vite": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tailwindcss": "latest",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
