# Copier en ml/lab/.env (ignoré par git) et remplacer les valeurs.

# Mot de passe admin Grafana du labo (Grafana écoute uniquement sur 127.0.0.1).
GRAFANA_ADMIN_PASSWORD=change-me

# Adresse d'écoute du WAF. 0.0.0.0 = joignable depuis le PC attaquant via RESILIENCE-G6.
WAF_BIND=0.0.0.0
WAF_PORT=8080

# Sources autorisées à fixer X-Forwarded-For. 172.16.0.0/12 = passerelles Docker,
# pour que le générateur de trafic normal (sur l'hôte) simule plusieurs clients.
WAF_TRUSTED_PROXIES=172.16.0.0/12

# Ports locaux (127.0.0.1) de l'observabilité du labo.
GRAFANA_PORT=3300
PROMETHEUS_PORT=9090
LOKI_PORT=3100
