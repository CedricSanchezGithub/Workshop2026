{
  "uid": "ai-lab-overview",
  "title": "Labo IA — Vue d'ensemble",
  "schemaVersion": 39,
  "time": {"from": "now-30m", "to": "now"},
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries", "title": "Requêtes / s par statut",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (status) (rate(http_requests_total[1m]))", "legendFormat": "{{status}}"}]
    },
    {
      "type": "timeseries", "title": "Latence p95 (s) par route",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[1m])))", "legendFormat": "{{route}}"}]
    },
    {
      "type": "timeseries", "title": "Transactions / s",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (status) (rate(payments_total[1m]))", "legendFormat": "{{status}}"}]
    },
    {
      "type": "timeseries", "title": "Blocages WAF (403) / min",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "sum(count_over_time({container=\"waf\"} |~ \"^\\\\{\\\"transaction\\\"\" |= \"\\\"http_code\\\":403\" [1m]))", "legendFormat": "403 WAF"}]
    },
    {
      "type": "logs", "title": "Journaux API",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{container=\"payment-api\"}"}]
    }
  ]
}
