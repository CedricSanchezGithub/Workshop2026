{
  "uid": "soc-siem",
  "title": "SOC / SIEM — Sécurité",
  "tags": ["security", "siem", "soc"],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "WAF — Filtrage applicatif (WOR-60)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Blocages WAF (403) / min",
      "description": "Requêtes refusées par ModSecurity/CRS, par minute.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 40, "lineWidth": 1, "showPoints": "never" },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "range",
          "expr": "sum(count_over_time({container=\"waf\"} |= \"ModSecurity\" |= \"denied\" [1m]))",
          "legendFormat": "blocages/min"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Blocages WAF (fenêtre)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "sum(count_over_time({container=\"waf\"} |= \"denied\" [$__range]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Injections SQLi — CRS 942xxx (fenêtre)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 20 } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "sum(count_over_time({container=\"waf\"} |= \"transaction\" |~ \"942[0-9]{3}\" [$__range]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Derniers blocages WAF",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "options": {
        "showTime": true, "showLabels": false, "wrapLogMessage": true,
        "prettifyLogMessage": false, "enableLogDetails": true,
        "dedupStrategy": "none", "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "range",
          "expr": "{container=\"waf\"} |= \"denied\""
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Vault — Accès aux secrets (WOR-62)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Audit Vault / min (par type)",
      "description": "Requêtes et réponses du journal d'audit Vault (valeurs secrètes hachées).",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "range",
          "expr": "sum by (audit_type) (count_over_time({container=\"vault\", audit_type=~\"request|response\"} [1m]))",
          "legendFormat": "{{audit_type}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Corrélation des événements de sécurité",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Flux SIEM corrélé (WAF · Vault · PostgreSQL)",
      "description": "Lignes de sécurité pertinentes agrégées de plusieurs services.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 27 },
      "options": {
        "showTime": true, "showLabels": true, "wrapLogMessage": true,
        "prettifyLogMessage": false, "enableLogDetails": true,
        "dedupStrategy": "none", "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "range",
          "expr": "{container=~\"waf|vault|postgres\"} |~ \"(?i)denied|403|fatal|unauthorized|authentication failure\""
        }
      ]
    }
  ]
}
