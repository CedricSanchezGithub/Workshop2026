    {
      "id": 12,
      "type": "timeseries",
      "title": "Requêtes / s par IP client (top 10)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (client_ip) (count_over_time({container=\"waf\"} != \"transaction\" | regexp `^(?P<client_ip>\\d+\\.\\d+\\.\\d+\\.\\d+) ` | client_ip != \"\" [1m]))) / 60",
          "legendFormat": "{{client_ip}}",
          "queryType": "range"
        }
      ],
      "description": "Une IP qui écrase les autres = source d'un déni de service (scénario A).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
