    {
      "title": "Tableaux RESILIENCE-ALPHA",
      "type": "dashboards",
      "tags": [
        "resilience-alpha"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
