# Surcharge du default.conf.template de l'image owasp/modsecurity-crs (4.30.0-nginx-alpine).
# ModSecurity reste activé au niveau http (conf.d/modsecurity.conf) : il inspecte donc TOUTES
# les locations ci-dessous, site comme API (blocage CRS, scénario B, remédiation inchangés).
#
# Différence avec l'original : une seule location `/` proxifiait tout vers payment-api. Ici on
# sépare, en gardant le MÊME chemin (un seul saut) pour l'API afin de ne pas toucher l'IP source
# vue par payment-api (features ML distinct_ips / offenders) :
#   - API métier (/v1, /health, /metrics, /docs, /openapi.json) -> payment-api (include d'origine)
#   - tout le reste (site Pay&Go, SPA) -> conteneur `web` (statique nginx), résolution différée.

server_tokens ${SERVER_TOKENS};
more_set_headers 'Server: ${SERVER_HEADER}';

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen ${PORT} default_server;

    server_name ${SERVER_NAME};
    set $always_redirect ${NGINX_ALWAYS_TLS_REDIRECT};

    PROXY_SSL_CONFIG

    # --- API métier -> payment-api (saut unique, en-têtes et IP réelle identiques à l'origine) ---
    location /v1/ {
        client_max_body_size 0;
        include includes/cors.conf;
        include includes/proxy_backend.conf;
    }
    location = /health       { include includes/proxy_backend.conf; }
    location = /metrics      { include includes/proxy_backend.conf; }
    location = /docs         { include includes/proxy_backend.conf; }
    location = /openapi.json { include includes/proxy_backend.conf; }

    # --- Site Pay&Go (SPA) -> conteneur web ; résolution différée : le WAF démarre sans le front ---
    location / {
        client_max_body_size 0;

        if ($always_redirect = on) {
            return 301 https://$host$request_uri;
        }

        resolver 127.0.0.11 valid=10s ipv6=off;
        set $waf_frontend "http://web:8080";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_pass $waf_frontend;
    }

    include includes/location_common.conf;

}

server {
    listen ${SSL_PORT} ssl;
    HTTP3_CONFIG

    server_name ${SERVER_NAME};

    ssl_certificate ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};
    ssl_session_timeout 1d;
    ssl_session_cache shared:MozSSL:10m;
    ssl_session_tickets off;

    ssl_dhparam /etc/ssl/certs/dhparam-${SSL_DH_BITS}.pem;

    ssl_protocols ${SSL_PROTOCOLS};
    ssl_ciphers ${SSL_CIPHERS};
    ssl_prefer_server_ciphers ${SSL_PREFER_CIPHERS};

    ssl_stapling ${SSL_OCSP_STAPLING};
    ssl_stapling_verify ${SSL_OCSP_STAPLING};

    ssl_verify_client ${SSL_VERIFY};
    ssl_verify_depth ${SSL_VERIFY_DEPTH};

    PROXY_SSL_CONFIG

    location /v1/ {
        client_max_body_size 0;
        include includes/cors.conf;
        include includes/proxy_backend.conf;
    }
    location = /health       { include includes/proxy_backend.conf; }
    location = /metrics      { include includes/proxy_backend.conf; }
    location = /docs         { include includes/proxy_backend.conf; }
    location = /openapi.json { include includes/proxy_backend.conf; }

    location / {
        client_max_body_size 0;

        resolver 127.0.0.11 valid=10s ipv6=off;
        set $waf_frontend "http://web:8080";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_pass $waf_frontend;
    }

    include includes/location_common.conf;
}
