# Copie du nginx.conf.template de l'image owasp/modsecurity-crs (4.30.0-nginx-alpine), seule
# la directive worker_shutdown_timeout est ajoutée.
load_module modules/ngx_http_modsecurity_module.so;
# allows to add cors headers when replying with 403
load_module modules/ngx_http_headers_more_filter_module.so;

worker_processes ${NGINX_WORKER_PROCESSES};
# Remédiation (WOR-38) : après un `nginx -s reload` (nouvelle IP bloquée), les anciens workers
# ferment leurs connexions ouvertes au plus tard après 3 s. Sans cela, un attaquant qui garde ses
# connexions ouvertes continue d'être servi par l'ancienne configuration.
worker_shutdown_timeout 3s;
pid /tmp/nginx.pid;

events {
    worker_connections ${WORKER_CONNECTIONS};
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    client_body_timeout ${CLIENT_BODY_TIMEOUT};
    keepalive_timeout ${KEEPALIVE_TIMEOUT};
    sendfile on;
    http2 ${HTTP2};

    port_in_redirect ${NGINX_PORT_IN_REDIRECT};

    resolver RESOLVERS RESOLVER_CONFIG;
    include /etc/nginx/conf.d/*.conf;
}
