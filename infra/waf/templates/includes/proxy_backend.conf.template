proxy_set_header Host ${PROXY_HOST_HEADER};
proxy_set_header Proxy "";
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;
proxy_set_header ${REAL_IP_PROXY_HEADER} $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Port ${NGINX_X_FORWARDED_PORT};
proxy_set_header X-Forwarded-Proto ${NGINX_X_FORWARDED_PROTO};

proxy_http_version 1.1;
proxy_buffering off;
proxy_connect_timeout 60s;
proxy_read_timeout 36000s;
proxy_redirect off;

proxy_pass_header Authorization;

# Résolution DIFFÉRÉE du backend (WOR-60) : le resolver Docker (127.0.0.11) + une variable
# évitent que nginx résolve « payment-api » au démarrage. Le WAF démarre donc même si l'API
# n'existe pas encore (502 à la requête légitime), tout en bloquant déjà les injections
# (403, règles CRS 942xxx) — cf scénario B (WOR-59). Surcharge de l'include d'origine de
# l'image owasp/modsecurity-crs, seule la ligne proxy_pass change.
resolver 127.0.0.11 valid=10s ipv6=off;
set $waf_backend "${BACKEND}";
proxy_pass $waf_backend;

SET_REAL_IP_FROM
real_ip_header ${REAL_IP_HEADER};
real_ip_recursive ${REAL_IP_RECURSIVE};
