# Configuration NON secrète de la plateforme — copiée en infra/.env par
# `ansible-playbook playbooks/deploy.yml` si absent.
# Les mots de passe ne sont PAS ici : ils sont générés et stockés dans HashiCorp Vault (WOR-62).

# Adresse sur laquelle Grafana est publié.
#   127.0.0.1     -> cette machine uniquement (développement)
#   192.168.137.1 -> réseau du hotspot RESILIENCE-G6 (jour de la démo)
GRAFANA_BIND=127.0.0.1

# Adresse sur laquelle le WAF (point d'entrée de l'application) est publié.
#   127.0.0.1     -> cette machine uniquement (développement)
#   192.168.137.1 -> réseau du hotspot RESILIENCE-G6 (jour de la démo / PC Attaquant)
WAF_BIND=127.0.0.1

POSTGRES_DB=payments
POSTGRES_USER=payments

GRAFANA_ADMIN_USER=admin

# gid du groupe propriétaire de /var/run/docker.sock sur l'hôte (lecture des journaux via socket-proxy).
# Détecté et écrit automatiquement par deploy.yml ; à vérifier avec : stat -c %g /var/run/docker.sock
DOCKER_GID=
