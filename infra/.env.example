# Modèle de infra/.env — fichier commité : n'y mettre AUCUN vrai secret.
# `ansible-playbook playbooks/deploy.yml` copie ce fichier en infra/.env (non commité, droits 600)
# s'il n'existe pas, et remplace chaque `change-me` par un mot de passe aléatoire.
# Le déploiement est refusé tant qu'un `change-me` subsiste dans infra/.env.

# Adresse sur laquelle Grafana est publié.
#   127.0.0.1     -> cette machine uniquement (développement)
#   192.168.137.1 -> réseau du hotspot RESILIENCE-G6 (jour de la démo)
GRAFANA_BIND=127.0.0.1

POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=change-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
